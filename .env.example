# ==============================================================================
# Living Wiki - Environment Variables Configuration
# ==============================================================================

# Supabase Credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional service role key for elevated backend operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Swappable AI Engine Configuration (src/lib/ai-provider.ts)
# Providers supported: google | openai | anthropic

# 1. Synthesis Engine (In-depth knowledge extraction & incremental Markdown synthesis)
AI_SYNTHESIS_PROVIDER=google
AI_SYNTHESIS_MODEL=gemini-1.5-pro

# 2. Vision Engine (Page visual analysis, box_2d diagram detection)
# Gemini models natively support high-accuracy [ymin, xmin, ymax, xmax] 0-1000 bounding boxes
AI_VISION_PROVIDER=google
AI_VISION_MODEL=gemini-1.5-flash

# API Keys (Provide the keys for the providers you enable)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
